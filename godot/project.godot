; Engine configuration file.
config_version=5

[application]

config/name="Hollowmere"
config/description="A tide-bound descent through a drowned island."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="Hollowmere"

[rendering]

textures/canvas_textures/default_texture_filter=0
viewport/hdr_2d=false
anti_aliasing/quality/msaa_2d=2
